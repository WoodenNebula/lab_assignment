@model List<Student>

@{
	ViewData["Title"] = "Student List";
}

<div class="container mt-5">
	<div class="row mb-4">
		<div class="col-md-8">
			<h1>Student Management</h1>
		</div>
		<div class="col-md-4 text-end">
			<a asp-controller="Student" asp-action="Create" class="btn btn-primary">
				+ Add New Student
			</a>
		</div>
	</div>

	@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage)) {
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<strong>⚠️ Error:</strong> @ViewBag.ErrorMessage
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
		<div class="alert alert-warning">
			<h5>Troubleshooting:</h5>
			<p>The database connection failed. Please verify:</p>
			<ul>
				<li>SQL Server is running</li>
				<li>Database <strong>StudentDB</strong> exists</li>
				<li>Table <strong>Student</strong> exists</li>
				<li>Connection string in <code>appsettings.json</code> is correct</li>
			</ul>
			<p>See README.md for setup instructions.</p>
		</div>
	}

	@if (Model == null || Model.Count == 0) {
		<div class="alert alert-info">
			<strong>📋 No Students Found</strong><br/>
			The database is empty or no data has been added yet.<br/>
			<a asp-action="Create" class="btn btn-primary btn-sm mt-2">Add the First Student</a>
		</div>
	} else {
		<div class="table-responsive">
			<table class="table table-striped table-hover">
				<thead class="table-dark">
					<tr>
						<th>ID</th>
						<th>Name</th>
						<th>Address</th>
						<th>Faculty</th>
						<th>Email</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var student in Model) {
						<tr>
							<td>@student.StdID</td>
							<td>@student.Name</td>
							<td>@student.Address</td>
							<td>@student.Faculty</td>
							<td>@student.Email</td>
							<td>
								<a asp-action="Details" asp-route-id="@student.StdID" class="btn btn-sm btn-info">
									View
								</a>
								<a asp-action="Edit" asp-route-id="@student.StdID" class="btn btn-sm btn-warning">
									Edit
								</a>
								<a asp-action="Delete" asp-route-id="@student.StdID" class="btn btn-sm btn-danger">
									Delete
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
</div>
