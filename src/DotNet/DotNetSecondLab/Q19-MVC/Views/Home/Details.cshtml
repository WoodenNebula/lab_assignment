@model StudentModel

@{
	ViewData["Title"] = "Student Details";
}

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-md-6">
			<h2>Student Details</h2>
			<hr />

			<div class="card">
				<div class="card-body">
					<div class="mb-3">
						<strong>Student ID:</strong>
						<p>@Model.StdID</p>
					</div>

					<div class="mb-3">
						<strong>Name:</strong>
						<p>@Model.Name</p>
					</div>

					<div class="mb-3">
						<strong>Address:</strong>
						<p>@Model.Address</p>
					</div>

					<div class="mb-3">
						<strong>Faculty:</strong>
						<p>@Model.Faculty</p>
					</div>

					<div class="mb-3">
						<strong>Email:</strong>
						<p>@Model.Email</p>
					</div>

					<div class="mb-3">
						<strong>Phone Number:</strong>
						<p>@Model.PhoneNumber</p>
					</div>
				</div>
			</div>

			<div class="mt-3">
				<a asp-controller="Home" asp-action="StudentForm" class="btn btn-primary">Fill Another Form</a>
				<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Home</a>
			</div>
		</div>
	</div>
</div>
