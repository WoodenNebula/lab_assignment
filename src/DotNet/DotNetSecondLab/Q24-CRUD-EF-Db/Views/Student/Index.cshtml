@model IEnumerable<Q24_CRUD_EF_Db.Models.Student>

@{
	ViewData["Title"] = "Students List";
}

<h1>Students</h1>

<p>
	<a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

@if (Model != null && Model.Any())
{
	<table class="table table-striped table-hover">
		<thead class="table-dark">
			<tr>
				<th>First Name</th>
				<th>Last Name</th>
				<th>Email</th>
				<th>Phone</th>
				<th>Date of Birth</th>
				<th>Course</th>
				<th>Gpa</th>
				<th>Enrollment Date</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>@Html.DisplayFor(modelItem => item.FirstName)</td>
					<td>@Html.DisplayFor(modelItem => item.LastName)</td>
					<td>@Html.DisplayFor(modelItem => item.Email)</td>
					<td>@Html.DisplayFor(modelItem => item.Phone)</td>
					<td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td>
					<td>@Html.DisplayFor(modelItem => item.Course)</td>
					<td>@Html.DisplayFor(modelItem => item.Gpa)</td>
					<td>@Html.DisplayFor(modelItem => item.EnrollmentDate)</td>
					<td>
						<a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-sm btn-info">Details</a>
						<a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-sm btn-warning">Edit</a>
						<a asp-action="Delete" asp-route-id="@item.StudentId" class="btn btn-sm btn-danger">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="alert alert-info">
		<p>No students found. <a asp-action="Create">Create one now</a>.</p>
	</div>
}
